# ─── Config365 — environment variables ─────────────────────────────────────────
# Copy this file to .env — OR run scripts/setup.ps1 (Windows) / scripts/setup.sh (Linux/Mac)
# to auto-generate it with secure random secrets.
# Never commit .env to version control.

# ─── Portal ports (host-side) ────────────────────────────────────────────────
# Used by docker-compose.yml as ${PORTAL_HTTP_PORT}:80 — the ONLY supported run path.
# Caddy listens on port 80 inside the container. Default host port 8080 avoids
# conflicting with other local services on port 80.
PORTAL_HTTP_PORT=8080

# Optional — force the portal's public base URL for redirects and OAuth callbacks.
# When unset, derived from proxy headers (works for local http://localhost:8080).
# Required on Azure App Service when proxy headers leak internal ports (e.g. :4321).
# PUBLIC_URL=https://yourapp.azurewebsites.net

# ─── Azure AD ────────────────────────────────────────────────────────────────
# Azure AD credentials are configured through the setup wizard and stored in the
# database. You can override them here for development/emergency use only.
# AZURE_AD_CLIENT_ID=
# AZURE_AD_TENANT_ID=
# AZURE_AD_REDIRECT_URI=http://localhost:8080/auth/callback

# Platform admins (emergency fallback — first signer becomes admin automatically)
# PLATFORM_ADMIN_OIDS=

# ─── Session ─────────────────────────────────────────────────────────────────
# Leave blank — entrypoint generates on first start and persists under the data volume.
# SESSION_SECRET=

# ─── Gitea ───────────────────────────────────────────────────────────────────
# Gitea admin credentials and portal API token are managed automatically on first start.
#
# Emergency override only (leave blank in production):
# GITEA_TOKEN=
GITEA_ORG=config365
GITEA_RUNNER_NAME=config365-runner
RUNNER_SHARDS=4

# ─── M365 automation accounts ────────────────────────────────────────────────
# Collected during the setup wizard and stored in the database.
# These are set as Gitea org-level secrets so pipelines can authenticate to Graph.
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# M365_MSP_TENANT_ID=
